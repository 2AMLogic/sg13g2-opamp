{
  "_comment": [
    "Per-process shard of psrr.request.json for the klt 0.5.0 fleet runner: process mos_fs x 3 T x 3 VDD = 9 corners.",
    "Generated by sim/cmrr-psrr/klt/shard.py; the master request documents the full grid and the ratified-bound encoding."
  ],
  "netlist": "body-mos_fs.spice",
  "netlist_source": "schematic",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      "mos_fs"
    ],
    "supply_v": {
      "vdd": [
        1.08,
        1.2,
        1.32
      ],
      "vinp": [
        0.54,
        0.6,
        0.66
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "ac",
    "args": "dec 20 10m 1g"
  },
  "measurements": [
    {
      "name": "avs0_db",
      "spice": ".meas ac avs0_db find vdb(out) at=0.01",
      "unit": "dB"
    },
    {
      "name": "avs_plateau_db",
      "spice": ".meas ac avs_plateau_db find vdb(out) at=0.1",
      "unit": "dB"
    },
    {
      "name": "avs_plateau_delta_db",
      "spice": ".meas ac avs_plateau_delta_db param='abs(avs_plateau_db-avs0_db)'",
      "unit": "dB",
      "limits": {
        "max": 0.05
      }
    },
    {
      "name": "avs_1khz_db",
      "spice": ".meas ac avs_1khz_db find vdb(out) at=1000",
      "unit": "dB"
    }
  ],
  "options": {
    "timeout_s": 300,
    "keep_artifacts": false
  }
}
