{
  "_comment": [
    "sim/input-cmr as a `klt sim` request (issue #325). Generated by make_requests.py; do not edit by hand.",
    "Grid: cornerMOSlv.lib mos_tt/ss/ff/sf/fs (each with cornerCAP.lib cap_typ) x -40/27/125 C x VDD 1.08/1.20/1.32 V = 45 points.",
    "Circuit: tb_cmr.body.spice -- the harness DUT circuit plus an M5 replica and a constant-current Vth servo replica for the pair, both driven by the same swept source, so ONE dc sweep (Vcsw 0..1.32 V at 250 uV, 5281 samples) carries every curve the harness gets from separate probe runs. See that file's header.",
    "Bounds are read at the 250 uV sample grid with linear interpolation across the bracketing pair, as the harness fine pass (same 250 uV step). Lower bound: highest Vcm (within VDD) where v(tail) crosses the replica-measured Vdsat5 upward. Upper bound: first Vcm at or above VDD/2 where v(d1)-Vcm+Vth(CC) crosses zero downward, Vth taken at that sample's own body bias.",
    "No ratified limit is applied: the ICMR row is Measured (not yet ratified). The `limits` below are integrity checks only (bound located exactly once, bias replica matches the DUT, knee in the harness's plausible band, span > 50 mV); they keep coverage.nothing_checked false.",
    "vcm sweeps WITH vdd by index (klt supply_v semantics), so the centre bias is VDD/2 at every corner; the source it alters (Vcm) is a reference only -- the swept source is Vcsw.",
    "Solver tolerance: ngspice default (DR-0005). Comparisons use lt/gt/ge since < and > are I/O redirection in ngspice's command line (klayout-tools#2940).",
    "backend: batch for the grid -- a grid does not run on a shared dispatch host. If the batch submit fails, report it; there is no local fallback."
  ],
  "netlist": "tb_cmr.body.spice",
  "netlist_source": "schematic",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      {
        "name": "mos_tt",
        "sections": [
          "mos_tt",
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          }
        ]
      },
      {
        "name": "mos_ss",
        "sections": [
          "mos_ss",
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          }
        ]
      },
      {
        "name": "mos_ff",
        "sections": [
          "mos_ff",
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          }
        ]
      },
      {
        "name": "mos_sf",
        "sections": [
          "mos_sf",
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          }
        ]
      },
      {
        "name": "mos_fs",
        "sections": [
          "mos_fs",
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          }
        ]
      }
    ],
    "supply_v": {
      "vdd": [
        1.08,
        1.2,
        1.32
      ],
      "vcm": [
        0.54,
        0.6,
        0.66
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "Vcsw 0 1.32 250u"
  },
  "measurements": [
    {
      "name": "nc_idx",
      "expr": "floor(v(vdd)[0]/0.0005+0.5)",
      "unit": "index"
    },
    {
      "name": "nv_idx",
      "expr": "floor(v(vdd)[0]/0.00025+0.5)",
      "unit": "index"
    },
    {
      "name": "vibias_spread_v",
      "expr": "vecmax(v(ibias))-vecmin(v(ibias))",
      "unit": "V",
      "limits": {
        "max": 0.001
      }
    },
    {
      "name": "probe_bias_err_v",
      "expr": "abs(v(rbx)[0]-v(ibias)[0])",
      "unit": "V",
      "limits": {
        "max": 0.001
      }
    },
    {
      "name": "m5_gmax_sv",
      "expr": "vecmax(((i(Bd5)[0,5279]-i(Bd5)[1,5280])/0.00025))",
      "unit": "S",
      "limits": {
        "min": 0
      }
    },
    {
      "name": "m5_k",
      "expr": "vecmin(vector(5280)+5280*(((i(Bd5)[0,5279]-i(Bd5)[1,5280])/0.00025) gt 0.1*m5_gmax_sv))",
      "unit": "index"
    },
    {
      "name": "vdsat5_v",
      "expr": "v(inp)[m5_k+1]",
      "unit": "V",
      "limits": {
        "min": 0
      }
    },
    {
      "name": "vdsat5_frac",
      "expr": "vdsat5_v/v(vdd)[0]",
      "unit": "ratio",
      "limits": {
        "min": 0,
        "max": 0.5
      }
    },
    {
      "name": "lo_j",
      "expr": "vecmax(((v(tail)[1,5280]-vdsat5_v) ge 0)*((v(tail)[0,5279]-vdsat5_v) lt 0)*(vector(5280)+1 le nv_idx)*(vector(5280)+1))-1",
      "unit": "index",
      "limits": {
        "min": 0
      }
    },
    {
      "name": "lo_crossings",
      "expr": "5280*mean(((v(tail)[1,5280]-vdsat5_v) ge 0)*((v(tail)[0,5279]-vdsat5_v) lt 0)*(vector(5280)+1 le nv_idx))",
      "unit": "count",
      "limits": {
        "min": 0.99,
        "max": 1.01
      }
    },
    {
      "name": "lo_frac",
      "expr": "(vdsat5_v-v(tail)[lo_j])/(v(tail)[lo_j+1]-v(tail)[lo_j])",
      "unit": "ratio"
    },
    {
      "name": "icmr_lo_v",
      "expr": "v(inp)[lo_j]+lo_frac*(v(inp)[lo_j+1]-v(inp)[lo_j])",
      "unit": "V"
    },
    {
      "name": "hi_j",
      "expr": "vecmin(vector(5280)+5280*(1-((v(d1)[0,5279]-v(inp)[0,5279]+v(vthp)[0,5279]) ge 0)*((v(d1)[1,5280]-v(inp)[1,5280]+v(vthp)[1,5280]) lt 0)*(vector(5280) ge nc_idx)*(vector(5280)+1 le nv_idx)))",
      "unit": "index",
      "limits": {
        "max": 5279
      }
    },
    {
      "name": "hi_crossings",
      "expr": "5280*mean(((v(d1)[0,5279]-v(inp)[0,5279]+v(vthp)[0,5279]) ge 0)*((v(d1)[1,5280]-v(inp)[1,5280]+v(vthp)[1,5280]) lt 0)*(vector(5280) ge nc_idx)*(vector(5280)+1 le nv_idx))",
      "unit": "count",
      "limits": {
        "min": 0.99,
        "max": 1.01
      }
    },
    {
      "name": "hi_ya_v",
      "expr": "v(d1)[hi_j]-v(inp)[hi_j]+v(vthp)[hi_j]",
      "unit": "V"
    },
    {
      "name": "hi_yb_v",
      "expr": "v(d1)[hi_j+1]-v(inp)[hi_j+1]+v(vthp)[hi_j+1]",
      "unit": "V"
    },
    {
      "name": "icmr_hi_v",
      "expr": "v(inp)[hi_j]+hi_ya_v/(hi_ya_v-hi_yb_v)*(v(inp)[hi_j+1]-v(inp)[hi_j])",
      "unit": "V"
    },
    {
      "name": "icmr_span_v",
      "expr": "icmr_hi_v-icmr_lo_v",
      "unit": "V",
      "limits": {
        "min": 0.05
      }
    },
    {
      "name": "vtail_lo_v",
      "expr": "v(tail)[lo_j+1]",
      "unit": "V"
    },
    {
      "name": "vds1_lo_v",
      "expr": "v(d1)[lo_j+1]-v(tail)[lo_j+1]",
      "unit": "V"
    },
    {
      "name": "vds2_lo_v",
      "expr": "v(d2)[lo_j+1]-v(tail)[lo_j+1]",
      "unit": "V"
    },
    {
      "name": "ivdd_lo_a",
      "expr": "-i(vdd)[lo_j+1]",
      "unit": "A"
    },
    {
      "name": "vtail_hi_v",
      "expr": "v(tail)[hi_j]",
      "unit": "V"
    },
    {
      "name": "vgs1_hi_v",
      "expr": "v(inp)[hi_j]-v(tail)[hi_j]",
      "unit": "V"
    },
    {
      "name": "vds1_hi_v",
      "expr": "v(d1)[hi_j]-v(tail)[hi_j]",
      "unit": "V"
    },
    {
      "name": "vds2_hi_v",
      "expr": "v(d2)[hi_j]-v(tail)[hi_j]",
      "unit": "V"
    },
    {
      "name": "ivdd_hi_a",
      "expr": "-i(vdd)[hi_j]",
      "unit": "A"
    },
    {
      "name": "vth_pair_cc_v",
      "expr": "v(vthp)[hi_j]",
      "unit": "V"
    },
    {
      "name": "op_vout_v",
      "expr": "v(out)[nc_idx]",
      "unit": "V"
    },
    {
      "name": "op_vtail_v",
      "expr": "v(tail)[nc_idx]",
      "unit": "V"
    },
    {
      "name": "op_vd1_v",
      "expr": "v(d1)[nc_idx]",
      "unit": "V"
    },
    {
      "name": "op_vd2_v",
      "expr": "v(d2)[nc_idx]",
      "unit": "V"
    },
    {
      "name": "op_vibias_v",
      "expr": "v(ibias)[nc_idx]",
      "unit": "V"
    },
    {
      "name": "op_ivdd_a",
      "expr": "-i(vdd)[nc_idx]",
      "unit": "A"
    }
  ],
  "options": {
    "timeout_s": 300,
    "keep_artifacts": false,
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi"
    ],
    "stage_model_inputs": true,
    "fail_on_diagnostic": [
      "singular_matrix",
      "nonconvergence"
    ],
    "ngspice_init": [
      "set measureprec=12",
      "set numdgt=12"
    ]
  }
}
