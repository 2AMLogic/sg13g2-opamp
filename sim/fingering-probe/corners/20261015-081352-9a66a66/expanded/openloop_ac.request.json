{
 "netlist": "tb_openloop_ac.body.spice",
 "netlist_source": "schematic",
 "engine": "ngspice",
 "backend": "batch",
 "models": {
  "pdk": "ihp-sg13g2",
  "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
 },
 "corners": {
  "process": [
   {
    "name": "mos_tt",
    "sections": [
     "mos_tt",
     {
      "lib": "libs.tech/ngspice/models/cornerCAP.lib",
      "section": "cap_typ"
     }
    ]
   },
   {
    "name": "mos_ss",
    "sections": [
     "mos_ss",
     {
      "lib": "libs.tech/ngspice/models/cornerCAP.lib",
      "section": "cap_typ"
     }
    ]
   },
   {
    "name": "mos_ff",
    "sections": [
     "mos_ff",
     {
      "lib": "libs.tech/ngspice/models/cornerCAP.lib",
      "section": "cap_typ"
     }
    ]
   },
   {
    "name": "mos_sf",
    "sections": [
     "mos_sf",
     {
      "lib": "libs.tech/ngspice/models/cornerCAP.lib",
      "section": "cap_typ"
     }
    ]
   },
   {
    "name": "mos_fs",
    "sections": [
     "mos_fs",
     {
      "lib": "libs.tech/ngspice/models/cornerCAP.lib",
      "section": "cap_typ"
     }
    ]
   }
  ],
  "supply_v": {
   "vdd": [
    1.2
   ],
   "vinp": [
    0.6
   ]
  },
  "temperature_c": [
   27
  ]
 },
 "analysis": {
  "kind": "ac",
  "args": "dec 20 1 1g"
 },
 "measurements": [
  {
   "name": "av0_db",
   "spice": ".meas ac av0_db find vdb(out) at=1",
   "unit": "dB",
   "limits": {
    "min": 37.8
   }
  },
  {
   "name": "gbw_hz",
   "spice": ".meas ac gbw_hz when vdb(out)=0",
   "unit": "Hz",
   "limits": {
    "min": 4740000.0
   }
  },
  {
   "name": "phase_at_ugf_rad",
   "spice": ".meas ac phase_at_ugf_rad find vp(out) when vdb(out)=0",
   "unit": "rad",
   "limits": {
    "min": -2.0943951023931953,
    "max": 0.0
   }
  }
 ],
 "options": {
  "timeout_s": 300,
  "keep_artifacts": false,
  "osdi_preload": [
   "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
   "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
   "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi",
   "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi"
  ],
  "stage_model_inputs": true,
  "fail_on_diagnostic": [
   "singular_matrix",
   "nonconvergence"
  ],
  "ngspice_init": [
   "set measureprec=12",
   "set numdgt=12"
  ]
 }
}