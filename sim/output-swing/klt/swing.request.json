{
  "_comment": [
    "Coarse pass of the 45-point output-swing audit. run.sh grid centres each fine DC sweep on the serialized crossing measured here.",
    "Retain each full-resolution DC axis and Vout. The fine pass also retains the supply current and grades the native swing measurements."
  ],
  "netlist": "tb_swing.body.spice",
  "netlist_source": "schematic",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      {
        "name": "mos_tt",
        "sections": [
          "mos_tt",
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          }
        ]
      },
      {
        "name": "mos_ss",
        "sections": [
          "mos_ss",
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          }
        ]
      },
      {
        "name": "mos_ff",
        "sections": [
          "mos_ff",
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          }
        ]
      },
      {
        "name": "mos_sf",
        "sections": [
          "mos_sf",
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          }
        ]
      },
      {
        "name": "mos_fs",
        "sections": [
          "mos_fs",
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          }
        ]
      }
    ],
    "supply_v": {
      "vdd": [
        1.08,
        1.2,
        1.32
      ],
      "vcm": [
        0.54,
        0.6,
        0.66
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "Vid -0.1 0.1 0.0005"
  },
  "measurements": [],
  "options": {
    "timeout_s": 300,
    "keep_artifacts": true,
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi"
    ],
    "stage_model_inputs": true,
    "fail_on_diagnostic": [
      "singular_matrix",
      "nonconvergence"
    ],
    "ngspice_init": [
      "set measureprec=12",
      "set numdgt=12"
    ],
    "waveforms": true,
    "capture_only": true,
    "save_vectors": [
      "v(id)",
      "v(out)"
    ]
  }
}
